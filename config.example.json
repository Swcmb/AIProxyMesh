{
  "listen": "0.0.0.0:8080",
  "server_keys": [
    "sk-local-change-me-please-123456"
  ],
  "zen_keys": [],
  "go_keys": [],
  "anonymous": true,
  "proxies": [
    "direct"
  ],
  "proxyfile": "",
  "upstream": {
    "zen": "https://opencode.ai/zen",
    "go": "https://opencode.ai/zen/go",
    "anonymous": "https://opencode.ai/inference"
  },
  "retry": {
    "max_attempts": 3,
    "timeout_seconds": 300
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {},
    "free_only": false
  },
  "performance": {
    "max_idle_conns": 2048,
    "max_idle_conns_per_host": 256,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "attempt_timeout_seconds": 0,
    "first_event_timeout_seconds": 0
  },
  "logging": {
    "level": "info",
    "ring_size": 2000,
    "dump_request_bodies": false,
    "requests": {
      "enabled": true,
      "state_path": "/data/requests.db",
      "retention_days": 7,
      "max_rows": 200000,
      "buffer_size": 0
    }
  },
  "prefer": "go",
  "reasoning": {},
  "rotation": {
    "sota": {
      "alias": "sota"
    },
    "sweet": {
      "alias": "sweet"
    },
    "first_output_seconds": 30
  },
  "ranking": {
    "sota_task": "agent-coding",
    "sweet_task": "general-text",
    "latency_good_ms": 2000,
    "latency_bad_ms": 15000,
    "standard_input_tokens": 60000,
    "standard_output_tokens": 8000,
    "standard_cached_tokens": 20000,
    "go_monthly_cost_usd": 10,
    "go_monthly_tasks": 1000,
    "quota_headroom": {
      "zen": 100,
      "go": 100
    },
    "capabilities": {}
  },
  "webui": {
    "enabled": true,
    "listen": "0.0.0.0:8081",
    "username": "admin",
    "password": "change-me-please",
    "session_ttl_minutes": 720
  },
  "egress": {
    "enabled": true,
    "subscriptions": [],
    "import_legacy_proxies": true,
    "schedule": {
      "health_weight": 0.3,
      "latency_weight": 0.15,
      "routing_weight": 0.15,
      "upstream_success_weight": 0.4,
      "quota_weight": 0.15
    },
    "protocols": {
      "http": true,
      "https": true,
      "socks5": true,
      "socks5h": true
    },
    "cooldown": {
      "base_seconds": 30,
      "max_seconds": 900,
      "recovery_probe": true
    },
    "failover": {
      "status_policy": {
        "429": "switch-or-wait",
        "401": "key-rotation",
        "403": "key-rotation",
        "5xx": "retry-or-switch"
      },
      "request_method_policy": {
        "default": "retry-allowed"
      },
      "honor_retry_after": true
    },
    "probe": {
      "targets": [],
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "concurrency": 8,
      "egress_ip_enabled": true,
      "egress_ip_interval_seconds": 21600,
      "egress_ip_target": "https://cloudflare.com/cdn-cgi/trace",
      "scheduler": "heap",
      "budget_per_second": 2,
      "budget_burst": 4,
      "canary_enabled": true,
      "canary_model": "",
      "canary_default_mode": "stream",
      "canary_max_tokens": 1,
      "canary_max_inflight": 8,
      "canary_daily_budget": 20000,
      "canary_allow_key_tiers": false,
      "canary_key_daily_budget": 0,
      "active_recheck_seconds": 600,
      "verifying_recheck_seconds": 30,
      "backoff_base_seconds": 30,
      "backoff_max_seconds": 1800,
      "jitter_ratio": 0.5,
      "target_pause_seconds": 60,
      "max_schedule_per_scan": 2000,
      "cluster_recheck_seconds": 600,
      "max_scheduled_keys": 50000
    },
    "bootstrap": {
      "mode": "direct",
      "url": "",
      "probe_url": "",
      "probe_interval_seconds": 30,
      "probe_failure_threshold": 3,
      "bootstrap_latency_budget_ms": 3000,
      "failure_grace_seconds": 60,
      "local_failure_threshold": 0.3,
      "local_failure_window_seconds": 300
    },
    "health": {
      "mode": "shadow",
      "confidence_z": 1.96,
      "min_samples": 96,
      "valid_min_samples": 46,
      "evidence_bucket_seconds": 60,
      "max_admission_samples_per_bucket": 10,
      "min_evidence_buckets": 5,
      "http200_target": 0.95,
      "valid_target": 0.9,
      "decay_half_life_seconds": 3600,
      "recent_quantile": 0.1,
      "suspect_recent_lower": 0.5,
      "suspect_recovery_lower": 0.8,
      "min_recent_weight": 10,
      "suspect_failures": 2,
      "suspect_latency_min_samples": 5,
      "suspect_recovery_successes": 3,
      "reverify_successes": 3,
      "unknown_streak_suspect": 5,
      "stream_failure_suspect": 2,
      "open_failures": 3,
      "open_rate_window_seconds": 600,
      "open_rate_threshold": 0.5,
      "half_open_successes": 3,
      "half_open_max_inflight": 1,
      "dead_confirmations": 2,
      "dead_recheck_seconds": 21600,
      "latency_budget_ms": 8000,
      "max_valid_peek_bytes": 8192,
      "max_keys_per_node": 4,
      "max_pending_keys": 10000,
      "max_pending_observations": 10000,
      "stable_min_capacity": 50,
      "quota_stale_seconds": 300,
      "exploration_ratio": 0.1,
      "candidate_exploration_ratio": 0.02,
      "route_sample_size": 64,
      "cold_start_fallback": true,
      "reachable_window_seconds": 600,
      "max_dirty_rows": 5000
    },
    "state_path": "/data/egress.db",
    "max_latency_entries": 128,
    "geoip": {
      "enabled": true,
      "url": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/country.mmdb",
      "sha256": "",
      "path": "/data/country.mmdb",
      "refresh_days": 7
    }
  }
}
