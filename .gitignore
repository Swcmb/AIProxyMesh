# 真实凭据（含 RESIN_ADMIN_TOKEN / RESIN_PROXY_TOKEN），模板见 .env.example
deploy/resin/.env

# 真实凭据：由 deploy/opencode2api/generate_configs.py 生成，不入库
deploy/opencode2api/credentials.json
deploy/opencode2api/instance-*/config.json

# 运行时数据：容器挂载点与抓取到的代理清单
deploy/resin/data/
deploy/opencode2api/proxies/proxies-*.txt
